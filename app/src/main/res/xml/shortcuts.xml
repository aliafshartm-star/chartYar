<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="new_analysis"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_analysis"
        android:shortcutLongLabel="@string/shortcut_new_analysis_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.chartyar.app"
            android:targetClass="com.chartyar.app.MainActivity">
