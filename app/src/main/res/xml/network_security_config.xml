        </trust-anchors>
    </domain-config>

    <!-- تلگرام و اینستاگرام (برای باز شدن لینک) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">t.me</domain>
        <domain includeSubdomains="true">telegram.org</domain>
        <domain includeSubdomains="true">instagram.com</domain>
        <domain includeSubdomains="true">www.instagram.com</domain>
        <trust-anchors>
