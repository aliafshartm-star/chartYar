<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Cloudflare Workers (برای Nobitex + Prices) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">workers.dev</domain>
        <domain includeSubdomains="true">chartyar-app.workers.dev</domain>
        <domain includeSubdomains="true">chartyar-prices.chartyar-app.workers.dev</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Nobitex -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">nobitex.ir</domain>
        <domain includeSubdomains="true">apiv2.nobitex.ir</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Binance -->
